{
    "version": "1.21.0",
    "description": "Application gratuite et en français pour gérer ses comptes et son budget personnels (Windows 10/11). Données 100% locales, open source.",
    "homepage": "https://andre12230-png.github.io/Comptes-Budget/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/andre12230-png/Comptes-Budget/releases/download/v1.21.0/Comptes-Budget-1.21.0-win64.zip",
            "hash": "9d9044d7c64a3cdc686b30be2da14392abb8982a651d2a8587aa87ef99549835"
        }
    },
    "extract_dir": "Comptes-Budget",
    "pre_install": [
        "# Quand un element a conserver n'existe pas dans l'archive, Scoop cree",
        "# un DOSSIER a sa place. Pour comptes.db il faut un FICHIER, sinon",
        "# l'application echoue au demarrage (unable to open database file).",
        "# On cree donc le fichier vide ici : SQLite y ecrira son schema.",
        "if (!(Test-Path \"$persist_dir\\comptes.db\")) {",
        "    New-Item -ItemType Directory -Path \"$persist_dir\" -Force | Out-Null",
        "    New-Item -ItemType File -Path \"$persist_dir\\comptes.db\" | Out-Null",
        "}"
    ],
    "persist": [
        "comptes.db",
        "sauvegardes"
    ],
    "shortcuts": [
        [
            "Comptes-Budget.exe",
            "Comptes et Budget"
        ]
    ],
    "checkver": {
        "github": "https://github.com/andre12230-png/Comptes-Budget"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/andre12230-png/Comptes-Budget/releases/download/v$version/Comptes-Budget-$version-win64.zip"
            }
        }
    }
}
